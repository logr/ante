<?xml version="1.0" encoding="utf-8"?>
<!-- Accessibility strings the components announce. Prefixed so they cannot collide with an app
     module's resources once merged. Nothing user-visible on screen lives here: on-screen copy is
     passed in by the caller. -->
<resources>
    <string name="ante_state_voided">voided</string>
    <string name="ante_state_loading">Loading</string>
    <!-- Spoken for the whole avatar stack: "4 members: Alex, Sam, Maya, Jordan". -->
    <plurals name="ante_avatar_stack_members">
        <item quantity="one">%1$d member: %2$s</item>
        <item quantity="other">%1$d members: %2$s</item>
    </plurals>
</resources>
